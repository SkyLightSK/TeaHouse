# Copy to .env.local and fill in.

# Colyseus server URL (defaults to ws://localhost:2567 in dev)
VITE_SERVER_URL=ws://localhost:2567

# Default avatar GLB URL (Ready Player Me). Users can override per-session.
VITE_DEFAULT_AVATAR_URL=https://models.readyplayer.me/64bfa7b5d1d6e7001e8e1f1a.glb

# Set "true" to enable WebXR (Quest browser, Vision Pro)
VITE_ENABLE_XR=false
