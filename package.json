{
  "name": "teahouse",
  "version": "0.1.0",
  "private": true,
  "description": "Portable 3D recreation of the TeaHouse establishment, deployable to multiple multiplayer runtimes (custom web R3F, Spatial.io, Mozilla Hubs, VRChat).",
  "license": "CC-BY-NC-4.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate:spec": "tsx tools/validate-spec.ts spec/teahouse.room.json",
    "export:all": "bash tools/export-all.sh",
    "dev": "pnpm -C runtimes/web-r3f dev",
    "dev:client": "pnpm -C runtimes/web-r3f/apps/client dev",
    "dev:server": "pnpm -C runtimes/web-r3f/apps/server dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
